NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# URLs dos servicos downstream
BACKEND_URL=http://localhost:3333
QUIZ_SERVICE_URL=http://localhost:3334

# Chave da Gemini API (https://aistudio.google.com/apikey); vazia desliga /ia/perguntar
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Segredo compartilhado com Backend e AI (gerar com: openssl rand -hex 32)
INTERNAL_TOKEN=

# JWT - mesmo segredo usado pelo Backend
JWT_SECRET_KEY=

# CORS - origens publicas que podem consumir o BFF
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Timeout (ms) para chamadas ao Backend e AI
REQUEST_TIMEOUT_MS=15000

# Limite por IP, por instancia do BFF (janela em ms)
RATE_LIMIT_MAX=1200
RATE_LIMIT_WINDOW_MS=60000

# Manter 0 ate confirmar a quantidade de proxies confiaveis da hospedagem
TRUST_PROXY_HOPS=0
